# Salin file ini menjadi .env lalu isi sesuai kebutuhan
# Mode: development (default) | production
FLASK_ENV=development
PORT=5000

# CORS untuk production (comma-separated). Diabaikan saat development.
CORS_ORIGINS=https://dramacina.vip,https://www.dramacina.vip
CORS_SUPPORTS_CREDENTIALS=false

# Timeout request ke upstream API (detik). Naikkan kalau sering timeout.
REQUEST_TIMEOUT=8

# Override creator name yang muncul di response envelope
# APP_CREATOR=MasantoID

# Override token & endpoint upstream (opsional)
# TOKEN_MAIN=
# GS_BASE=https://captain.sapimu.au/goodshort
# DBT_BASE=https://captain.sapimu.au/dramabite
# DNV_BASE=https://captain.sapimu.au/dramanova
